// lmsr-fe M0: WAD (1e18) fixed-point core for an LMSR prediction-market maker.
// Built on std's 512-bit mul_div, so a*b never overflows before the division.

use core::num::{mul_div, mul_div_ceil, isqrt}

pub const WAD: u256 = 1_000_000_000_000_000_000

/// a * b / WAD, rounded down (full 512-bit intermediate).
pub fn wad_mul_down(_ a: u256, _ b: u256) -> u256 {
    mul_div(a, b, WAD)
}

/// a * b / WAD, rounded up. Used where the market maker must never under-charge.
pub fn wad_mul_up(_ a: u256, _ b: u256) -> u256 {
    mul_div_ceil(a, b, WAD)
}

/// a * WAD / b, rounded down. Reverts if b == 0.
pub fn wad_div_down(_ a: u256, _ b: u256) -> u256 {
    mul_div(a, WAD, b)
}

/// a * WAD / b, rounded up. Reverts if b == 0.
pub fn wad_div_up(_ a: u256, _ b: u256) -> u256 {
    mul_div_ceil(a, WAD, b)
}

/// Square root of a WAD value, returned in WAD (floor).
pub fn wad_sqrt(_ x: u256) -> u256 {
    isqrt(mul_div(x, WAD, 1))
}

// ---------------------------------------------------------------------------
// M1: transcendental functions. Unsigned-only by design: LMSR is evaluated in
// log-sum-exp form, so exp is only ever called on non-positive arguments and
// ln only on values >= 1. No signed arithmetic is needed.
// ---------------------------------------------------------------------------

/// floor(ln(2) * 1e18)
pub const LN2_WAD: u256 = 693_147_180_559_945_309

/// floor(ln(2) * 1e36): used for k*ln2 so the error does not grow with k.
pub const LN2_E36: u256 = 693_147_180_559_945_309_417_232_121_458_176_568

/// exp(-x) for a WAD x >= 0, returned in WAD, rounded down (error <= a few wei).
/// Range reduction: x = k*ln2 + r with 0 <= r < ln2, so exp(-x) = 2^-k / exp(r).
pub fn exp_neg_wad(_ x: u256) -> u256 {
    let k: u256 = x / LN2_WAD
    if k >= 60 { return 0 }
    let r: u256 = x - k * LN2_WAD
    // Taylor series for exp(r); r < 0.7 so terms vanish after ~25 steps.
    var term: u256 = WAD
    var sum: u256 = WAD
    var i: u256 = 1
    while term > 0 {
        term = mul_div(term, r, WAD * i)
        sum += term
        i += 1
    }
    mul_div(WAD, WAD, sum) >> k
}

/// ln(x) for a WAD x >= 1.0, returned in WAD, rounded down. Reverts if x < WAD.
/// x = 2^k * y with 1 <= y < 2, ln(y) = 2 * atanh((y-1)/(y+1)), |z| <= 1/3.
/// The series runs at 1e36 internal precision so the WAD result is within
/// about one wei; k*ln2 uses LN2_E36 so the error does not grow with k.
pub fn ln_wad(_ x: u256) -> u256 {
    assert!(x >= WAD)
    let one: u256 = WAD * WAD
    var y: u256 = mul_div(x, WAD, 1)
    var k: u256 = 0
    while y >= 2 * one {
        y = y >> 1
        k += 1
    }
    let z: u256 = mul_div(y - one, one, y + one)
    let z2: u256 = mul_div(z, z, one)
    var term: u256 = z
    var sum: u256 = 0
    var i: u256 = 1
    while term > 0 {
        sum += term / i
        term = mul_div(term, z2, one)
        i += 2
    }
    (2 * sum + k * LN2_E36) / WAD
}

// ---------------------------------------------------------------------------
// Two-outcome LMSR market maker (quantities and liquidity b in WAD).
//   C(q1, q2) = b * ln(exp(q1/b) + exp(q2/b))
//             = max(q1, q2) + b * ln(1 + exp(-|q1 - q2| / b))
// ---------------------------------------------------------------------------

/// Rounding-error budget per 1.0 of liquidity b, in wei. ln_wad/exp_neg_wad are
/// accurate to a few wei, and lmsr_cost multiplies that by b; charges add
/// cost_err(b) so the maker never under-charges against the exact cost.
pub const COST_ERR_PER_B: u256 = 64

pub fn cost_err(_ b: u256) -> u256 {
    wad_mul_up(b, COST_ERR_PER_B) + COST_ERR_PER_B
}

fn abs_diff(_ a: u256, _ b: u256) -> u256 {
    if a >= b { return a - b }
    b - a
}

fn max_u(_ a: u256, _ b: u256) -> u256 {
    if a >= b { return a }
    b
}

/// LMSR cost function C(q1, q2) with liquidity parameter b (all WAD).
pub fn lmsr_cost(_ q1: u256, _ q2: u256, _ b: u256) -> u256 {
    let e: u256 = exp_neg_wad(mul_div(abs_diff(q1, q2), WAD, b))
    max_u(q1, q2) + wad_mul_down(b, ln_wad(WAD + e))
}

/// Instantaneous price of outcome 1 (WAD probability).
pub fn lmsr_price1(_ q1: u256, _ q2: u256, _ b: u256) -> u256 {
    let e: u256 = exp_neg_wad(mul_div(abs_diff(q1, q2), WAD, b))
    if q1 >= q2 {
        return mul_div(WAD, WAD, WAD + e)
    }
    mul_div(e, WAD, WAD + e)
}

/// Collateral a trader pays to buy `amount` shares of outcome 1, rounded in the
/// maker's favour (exact cost difference plus the documented error bound).
pub fn lmsr_buy1_cost(_ q1: u256, _ q2: u256, _ b: u256, _ amount: u256) -> u256 {
    sat_sub(lmsr_cost(q1 + amount, q2, b), lmsr_cost(q1, q2, b)) + cost_err(b)
}

/// a - b, or 0 if b > a. Used so a sub-wei inversion of the computed cost
/// curve (possible only for dust-sized trades) can never revert or pay out.
pub fn sat_sub(_ a: u256, _ b: u256) -> u256 {
    if a >= b { return a - b }
    0
}

/// Collateral paid out to a trader who sells `amount` shares of outcome 1 back
/// to the maker, rounded in the maker's favour: the computed cost difference
/// minus the error bound, floored at 0. Reverts if amount > q1 (the maker never
/// buys back shares it did not sell). Because buy and sell use the same
/// deterministic cost function, buy-then-sell of the same amount returns
/// exactly 2 * cost_err(b) less than was paid in, so a round trip never profits.
pub fn lmsr_sell1_payout(_ q1: u256, _ q2: u256, _ b: u256, _ amount: u256) -> u256 {
    assert!(amount <= q1)
    sat_sub(
        sat_sub(lmsr_cost(q1, q2, b), lmsr_cost(q1 - amount, q2, b)),
        cost_err(b),
    )
}

// ---------------------------------------------------------------------------
// N-outcome LMSR (M2). Log-sum-exp with a max shift:
//   C(q) = m + b * ln( sum_i exp(-(m - q_i) / b) ),   m = max_i q_i
// Every exponent is <= 0, so exp_neg_wad never overflows, and the sum is in
// [1, n] (the max term is exactly 1), so ln_wad always sees an argument >= 1.
// Functions take a fixed-size array plus `n`, the number of live outcomes
// (2 <= n <= N); entries at index >= n are ignored. This lets a contract keep
// one storage layout for any outcome count up to its capacity.
// ---------------------------------------------------------------------------

/// Error budget for an n-outcome cost evaluation: each of the n exp terms and
/// the final ln contribute a few wei per 1.0 of b.
pub fn cost_err_n(_ b: u256, _ n: usize) -> u256 {
    let k: u256 = COST_ERR_PER_B * (n as u256)
    wad_mul_up(b, k) + k
}

fn max_n<const N: usize>(_ q: [u256; N], _ n: usize) -> u256 {
    assert!(n >= 2 && n <= N)
    var m: u256 = 0
    var i: usize = 0
    while i < n {
        if q[i] > m { m = q[i] }
        i += 1
    }
    m
}

/// sum_i exp(-(m - q_i) / b) in WAD (>= WAD), together with the shift m.
fn sum_exp_n<const N: usize>(_ q: [u256; N], _ n: usize, _ b: u256) -> (u256, u256) {
    let m: u256 = max_n(q, n)
    var s: u256 = 0
    var i: usize = 0
    while i < n {
        s += exp_neg_wad(mul_div(m - q[i], WAD, b))
        i += 1
    }
    (m, s)
}

/// N-outcome LMSR cost function C(q) with liquidity b (all WAD), rounded down.
pub fn lmsr_cost_n<const N: usize>(_ q: [u256; N], _ n: usize, _ b: u256) -> u256 {
    let (m, s) = sum_exp_n(q, n, b)
    m + wad_mul_down(b, ln_wad(s))
}

/// Instantaneous price of outcome `i` (WAD probability), rounded down, so the
/// n prices sum to at most 1.0 and to within n wei of it.
pub fn lmsr_price_n<const N: usize>(_ q: [u256; N], _ n: usize, _ b: u256, _ i: usize) -> u256 {
    assert!(i < n)
    let (m, s) = sum_exp_n(q, n, b)
    mul_div(exp_neg_wad(mul_div(m - q[i], WAD, b)), WAD, s)
}

/// Collateral to buy `amount` shares of outcome `i`, rounded in the maker's
/// favour (computed cost difference plus cost_err_n).
pub fn lmsr_buy_cost_n<const N: usize>(
    _ q: [u256; N],
    _ n: usize,
    _ b: u256,
    _ i: usize,
    _ amount: u256,
) -> u256 {
    assert!(i < n)
    var after = q
    after[i] = q[i] + amount
    sat_sub(lmsr_cost_n(after, n, b), lmsr_cost_n(q, n, b)) + cost_err_n(b, n)
}

/// Collateral paid for selling `amount` shares of outcome `i` back, rounded in
/// the maker's favour (computed difference minus cost_err_n, floored at 0).
/// Reverts if amount > q[i].
pub fn lmsr_sell_payout_n<const N: usize>(
    _ q: [u256; N],
    _ n: usize,
    _ b: u256,
    _ i: usize,
    _ amount: u256,
) -> u256 {
    assert!(i < n)
    assert!(amount <= q[i])
    var after = q
    after[i] = q[i] - amount
    sat_sub(
        sat_sub(lmsr_cost_n(q, n, b), lmsr_cost_n(after, n, b)),
        cost_err_n(b, n),
    )
}

/// Subsidy the market creator must lock so the maker is always solvent:
/// worst-case loss b * ln(n), rounded up, plus the cost error budget.
pub fn lmsr_max_loss(_ b: u256, _ n: usize) -> u256 {
    wad_mul_up(b, ln_wad((n as u256) * WAD) + 1) + cost_err_n(b, n)
}
