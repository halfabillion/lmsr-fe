// Contract tests: deploy the Market on the test EVM and trade against it.
// Payouts go to plain payee addresses (the test harness account itself does
// not accept ETH transfers), and balances are checked there.

use ingot::market::{Market, MarketMsg}
use ingot::{WAD, lmsr_max_loss}
use std::evm::{ether, wei}

const B: u256 = 10_000_000_000_000_000_000

fn deploy(_ n: u256) -> Address uses (evm: mut Evm) {
    let subsidy = lmsr_max_loss(B, n as usize)
    evm.create2<Market>(value: wei(subsidy), args: (B, n), salt: 0)
}

fn buy(_ m: Address, _ outcome: u256, _ amount: u256, _ pay: Wei, _ refund_to: Address) -> u256
uses (evm: mut Evm)
{
    evm.call(
        addr: m,
        gas: 3000000,
        value: pay,
        message: MarketMsg::Buy { outcome, amount, refund_to },
    )
}

fn sell(_ m: Address, _ outcome: u256, _ amount: u256, _ to: Address) -> u256
uses (evm: mut Evm)
{
    evm.call(
        addr: m,
        gas: 3000000,
        value: Wei::zero(),
        message: MarketMsg::Sell { outcome, amount, to },
    )
}

fn price(_ m: Address, _ outcome: u256) -> u256 uses (evm: mut Evm) {
    evm.call(
        addr: m,
        gas: 3000000,
        value: Wei::zero(),
        message: MarketMsg::Price { outcome },
    )
}

fn resolve(_ m: Address, _ outcome: u256) uses (evm: mut Evm) {
    let _: u256 = evm
        .call(
            addr: m,
            gas: 3000000,
            value: Wei::zero(),
            message: MarketMsg::Resolve { outcome },
        )
}

#[test(balance = 1_000_000_000_000_000_000_000)]
fn market_buy_charges_quote_and_refunds() uses (evm: mut Evm) {
    let m = deploy(3)
    let subsidy = lmsr_max_loss(B, 3)
    assert!(evm.balance(m) == wei(subsidy))
    let quote: u256 = evm
        .call(
            addr: m,
            gas: 3000000,
            value: Wei::zero(),
            message: MarketMsg::QuoteBuy { outcome: 0, amount: 5 * WAD },
        )
    let payee = Address::new(0x1111)
    let cost = buy(m, 0, 5 * WAD, ether(20), payee)
    assert!(cost == quote)
    // Only the quoted cost is kept; the rest of the 20 ETH is refunded.
    assert!(evm.balance(m) == wei(subsidy + cost))
    assert!(evm.balance(payee) == ether(20) - wei(cost))
    let held: u256 = evm
        .call(
            addr: m,
            gas: 3000000,
            value: Wei::zero(),
            message: MarketMsg::SharesOf { owner: evm.address(), outcome: 0 },
        )
    assert!(held == 5 * WAD)
    // Buying outcome 0 raised its price above 1/3 and lowered the others.
    let p0 = price(m, 0)
    let p1 = price(m, 1)
    let p2 = price(m, 2)
    assert!(p0 > WAD / 3 && p1 < WAD / 3 && p2 == p1)
    assert!(p0 + p1 + p2 <= WAD && WAD - (p0 + p1 + p2) <= 48)
}

#[test(should_revert, balance = 1_000_000_000_000_000_000_000)]
fn market_underfunded_deploy_reverts() uses (evm: mut Evm) {
    let subsidy = lmsr_max_loss(B, 4)
    let _ = evm.create2<Market>(value: wei(subsidy - 1), args: (B, 4), salt: 0)
}

#[test(should_revert, balance = 1_000_000_000_000_000_000_000)]
fn market_underpaid_buy_reverts() uses (evm: mut Evm) {
    let m = deploy(2)
    let _ = buy(m, 1, 5 * WAD, wei(1), Address::new(0x1111))
}

#[test(balance = 1_000_000_000_000_000_000_000)]
fn market_round_trip_never_profits() uses (evm: mut Evm) {
    let m = deploy(4)
    let subsidy = lmsr_max_loss(B, 4)
    let payee = Address::new(0x2222)
    let quote: u256 = evm
        .call(
            addr: m,
            gas: 3000000,
            value: Wei::zero(),
            message: MarketMsg::QuoteBuy { outcome: 2, amount: 7 * WAD },
        )
    // Pay the exact quote so no refund is involved.
    let paid = buy(m, 2, 7 * WAD, wei(quote), payee)
    assert!(paid == quote)
    let back = sell(m, 2, 7 * WAD, payee)
    assert!(back < paid)
    assert!(evm.balance(payee) == wei(back))
    // The maker keeps the rounding margin; it never dips into the subsidy.
    assert!(evm.balance(m) == wei(subsidy + paid - back))
}

#[test(should_revert, balance = 1_000_000_000_000_000_000_000)]
fn market_sell_more_than_held_reverts() uses (evm: mut Evm) {
    let m = deploy(2)
    let _ = buy(m, 0, 3 * WAD, ether(10), Address::new(0x1111))
    let _ = sell(m, 0, 3 * WAD + 1, Address::new(0x1111))
}

#[test(balance = 1_000_000_000_000_000_000_000)]
fn market_resolve_redeem_sweep() uses (evm: mut Evm) {
    let m = deploy(3)
    let refunds = Address::new(0x3333)
    let _ = buy(m, 0, 12 * WAD, ether(20), refunds)
    let _ = buy(m, 1, 4 * WAD, ether(20), refunds)
    let _ = sell(m, 0, 2 * WAD, refunds)
    let _ = buy(m, 2, 30 * WAD, ether(40), refunds)
    resolve(m, 2)
    // Solvent: the contract holds at least the 30 winning shares' payout.
    assert!(evm.balance(m) >= ether(30))
    let winner = Address::new(0x4444)
    let got: u256 = evm
        .call(
            addr: m,
            gas: 3000000,
            value: Wei::zero(),
            message: MarketMsg::Redeem { to: winner },
        )
    assert!(got == 30 * WAD)
    assert!(evm.balance(winner) == ether(30))
    let creator_box = Address::new(0x5555)
    let left = evm.balance(m)
    let swept: u256 = evm
        .call(
            addr: m,
            gas: 3000000,
            value: Wei::zero(),
            message: MarketMsg::Sweep { to: creator_box },
        )
    assert!(wei(swept) == left && swept > 0)
    assert!(evm.balance(m) == Wei::zero())
}

#[test(should_revert, balance = 1_000_000_000_000_000_000_000)]
fn market_trading_after_resolve_reverts() uses (evm: mut Evm) {
    let m = deploy(2)
    resolve(m, 0)
    let _ = buy(m, 0, WAD, ether(5), Address::new(0x1111))
}

#[test(should_revert, balance = 1_000_000_000_000_000_000_000)]
fn market_redeem_losing_side_reverts() uses (evm: mut Evm) {
    let m = deploy(2)
    let _ = buy(m, 1, 3 * WAD, ether(10), Address::new(0x1111))
    resolve(m, 0)
    let _: u256 = evm
        .call(
            addr: m,
            gas: 3000000,
            value: Wei::zero(),
            message: MarketMsg::Redeem { to: Address::new(0x1111) },
        )
}

#[test(should_revert, balance = 1_000_000_000_000_000_000_000)]
fn market_double_resolve_reverts() uses (evm: mut Evm) {
    let m = deploy(2)
    resolve(m, 0)
    resolve(m, 1)
}
