    assert!(sum <= WAD && WAD - sum <= 16 * (n as u256))
    // Buy 10 of outcome 0: never under-charges the exact cost.
    let paid: u256 = lmsr_buy_cost_n(q, n, b, 0, 10 * WAD)
    assert!(paid > 3_445_647_128_146_614_556)
    assert!(paid - 3_445_647_128_146_614_556 <= 2 * tol)
    // Sell it straight back: never over-pays, round trip loses money.
    var after = q
    after[0] = q[0] + 10 * WAD
    let back: u256 = lmsr_sell_payout_n(after, n, b, 0, 10 * WAD)
    assert!(back <= 3_445_647_128_146_614_556)
    assert!(back < paid)
