// GENERATED by scripts/vectors.py -- do not edit by hand.
// Reference values: Python decimal, 80 significant digits, floored to wei.

use ingot::{WAD, cost_err_n, lmsr_cost_n, lmsr_price_n, lmsr_buy_cost_n, lmsr_sell_payout_n}

fn near(_ got: u256, _ want: u256, _ tol: u256) -> bool {
    if got >= want {
        return got - want <= tol
    }
    want - got <= tol
}

#[test]
fn vec_n3_flat() {
    let q: [u256; 3] = [0, 0, 0]
    let n: usize = 3
    let b: u256 = 100 * WAD
    let tol: u256 = cost_err_n(b, n)
    assert!(
        near(lmsr_cost_n(q, n, b), 109_861_228_866_810_969_139, tol),
    )
    assert!(
        near(lmsr_price_n(q, n, b, 0), 333_333_333_333_333_333, 16),
    )
    assert!(
        near(lmsr_price_n(q, n, b, 1), 333_333_333_333_333_333, 16),
    )
    assert!(
        near(lmsr_price_n(q, n, b, 2), 333_333_333_333_333_333, 16),
    )
    // Prices are rounded down: they sum to at most 1.0, within 16*n wei.
    var sum: u256 = 0
    var k: usize = 0
    while k < n {
        sum += lmsr_price_n(q, n, b, k)
        k += 1
    }
    assert!(sum <= WAD && WAD - sum <= 16 * (n as u256))
    // Buy 10 of outcome 0: never under-charges the exact cost.
    let paid: u256 = lmsr_buy_cost_n(q, n, b, 0, 10 * WAD)
    assert!(paid > 3_445_647_128_146_614_556)
    assert!(paid - 3_445_647_128_146_614_556 <= 2 * tol)
    // Sell it straight back: never over-pays, round trip loses money.
    var after = q
    after[0] = q[0] + 10 * WAD
    let back: u256 = lmsr_sell_payout_n(after, n, b, 0, 10 * WAD)
    assert!(back <= 3_445_647_128_146_614_556)
    assert!(back < paid)
}

